# Normalize line endings to LF for all text files
# This prevents Windows CRLF issues when deploying to GitHub Pages
* text=auto eol=lf

# Explicitly treat binary files as binary (important for images)
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.ico binary
*.svg binary
*.webp binary

# Shell and config files should use LF
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
*.js text eol=lf
*.json text eol=lf
*.txt text eol=lf
